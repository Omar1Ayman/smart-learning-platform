# Auto-detect text files; normalize to LF in the repo
* text=auto

# Explicit LF for files that must stay LF (scripts, configs, code)
*.py    text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf
*.toml  text eol=lf
Dockerfile      text eol=lf
*.sh            text eol=lf

# Windows scripts (keep CRLF)
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary files (never touch)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.zip   binary
*.xlsx  binary