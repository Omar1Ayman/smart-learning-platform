# Copy to `.env` and fill in real values. Never commit the real .env file.
#
# For PRODUCTION, use `.env.production.example` instead — it lists every
# variable that `config/settings/prod.py` requires to boot. Missing any of
# those will raise a RuntimeError before the server starts.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# NOTE: DEBUG is hardcoded per settings module (dev=True, prod=False).
# There is intentionally no DJANGO_DEBUG env var — see config/settings/{dev,prod}.py.

# --- Database ---
DB_NAME=smart_learning
DB_USER=smart_learning
DB_PASSWORD=smart_learning
DB_HOST=localhost
DB_PORT=5432

# --- Frontend ↔ Backend ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Email (development only — console backend prints to stdout) ---
# EMAIL_BACKEND defaults to console; prod REQUIRES the SMTP_* vars below.
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@example.test